{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: 调试 vector 示例",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/exp/vector_demo.exe",
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "Path",
                    "value": "D:/mingw/mingw64/bin;${env:Path}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/mingw/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C++: 编译 vector 示例"
        },
        {
            "name": "C++: 调试当前文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "Path",
                    "value": "D:/mingw/mingw64/bin;${env:Path}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/mingw/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C++: 编译当前文件"
        }
    ]
}
