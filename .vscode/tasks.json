{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: 编译 vector 示例",
            "type": "process",
            "command": "D:/mingw/mingw64/bin/g++.exe",
            "args": [
                "-std=c++20",
                "-g",
                "-I",
                "${workspaceFolder}/My_STL",
                "${workspaceFolder}/exp/vector_demo.cpp",
                "-o",
                "${workspaceFolder}/exp/vector_demo.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "C++: 编译当前文件",
            "type": "process",
            "command": "D:/mingw/mingw64/bin/g++.exe",
            "args": [
                "-std=c++20",
                "-g",
                "-I",
                "${workspaceFolder}/My_STL",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
